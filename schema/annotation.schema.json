{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/janpuc/koment/main/schema/annotation.schema.json",
  "title": "koment annotation record",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "file", "kind", "body", "created", "anchor", "author"],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "file": {
      "$ref": "#/$defs/sourcePath"
    },
    "kind": {
      "enum": ["why", "gotcha", "invariant", "anti-pattern"]
    },
    "body": {
      "type": "string",
      "pattern": "\\S"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "anchor": {
      "$ref": "#/$defs/anchor"
    },
    "git": {
      "$ref": "#/$defs/git"
    },
    "author": {
      "$ref": "#/$defs/author"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["policy"]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "why"
          },
          "anchor": {
            "type": "object",
            "required": ["scope", "excerpt"],
            "properties": {
              "scope": {
                "const": "excerpt"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "//|/$"
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        },
        {
          "not": {
            "pattern": "^[A-Za-z]:"
          }
        }
      ]
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": {
              "const": "file"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "excerpt", "last_seen_line"],
          "properties": {
            "scope": {
              "const": "excerpt"
            },
            "excerpt": {
              "type": "string",
              "minLength": 1
            },
            "before": {
              "type": "string",
              "pattern": "^(?:[^\\n]*(?:\\n|$)){0,3}$"
            },
            "after": {
              "type": "string",
              "pattern": "^(?:[^\\n]*(?:\\n|$)){0,3}$"
            },
            "last_seen_line": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "path"],
      "dependentRequired": {
        "end_line": ["line"]
      },
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "source"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "email": {
          "type": "string"
        },
        "kind": {
          "enum": ["human", "agent", "unknown"]
        },
        "source": {
          "enum": ["git-config", "explicit", "session", "migration", "oidc-proxy", "bearer-credential"]
        },
        "account": {
          "type": "string"
        },
        "verified": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "const": "migration"
              }
            }
          },
          "else": {
            "properties": {
              "source": {
                "not": {
                  "const": "migration"
                }
              }
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception", "acknowledged"],
      "properties": {
        "exception": {
          "const": "inline-comment"
        },
        "acknowledged": {
          "const": true
        }
      }
    }
  }
}
