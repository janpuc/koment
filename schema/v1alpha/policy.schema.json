{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/janpuc/koment/main/schema/v1alpha/policy.schema.json",
  "title": "koment repository policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "spec"],
  "properties": {
    "apiVersion": {
      "const": "koment.dev/v1alpha"
    },
    "kind": {
      "const": "Policy"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comments", "agents"],
      "properties": {
        "comments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "intrinsic"],
          "properties": {
            "mode": {
              "const": "strict"
            },
            "intrinsic": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["toolchain-directive", "generated-marker", "upstream-link", "deprecated", "public-api"]
              }
            },
            "generatedPaths": {
              "$ref": "#/$defs/pathGlobs"
            },
            "vendoredPaths": {
              "$ref": "#/$defs/pathGlobs"
            }
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapters"],
          "properties": {
            "adapters": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["agents", "claude", "copilot", "cursor", "codex", "opencode"]
              }
            },
            "principles": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["back-compat-evidence"]
              }
            }
          }
        }
      }
    },
    "pathGlobs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "allOf": [
          {
            "not": {
              "pattern": "^/"
            }
          },
          {
            "not": {
              "pattern": "(^|/)\\.\\.(/|$)"
            }
          },
          {
            "not": {
              "pattern": "\\\\"
            }
          }
        ]
      }
    }
  }
}
